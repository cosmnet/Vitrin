# Vitrin Studio anahtarları — bu dosyayı `.env` olarak kopyala.
# Hepsi isteğe bağlı; anahtar yoksa ilgili özellik kapalı kalır.

# Wiro AI (arka plan/sticker üretimi, otomatik plan): https://wiro.ai
WIRO_API_KEY=
WIRO_API_SECRET=

# Görsel destekli Art Director için (yoksa Wiro'daki metin modeli kullanılır)
ANTHROPIC_API_KEY=
